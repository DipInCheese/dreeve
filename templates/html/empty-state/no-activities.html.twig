{% autoescape false %}
<div class="mx-auto max-w-xl mt-8 p-6 bg-white border border-gray-200 rounded-lg shadow-xs text-center">
    <span class="grid place-items-center size-12 mx-auto mb-3 rounded-full bg-primary-soft text-primary" aria-hidden="true">
        <svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v9m-5 0H5a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1h-2M8 9l4-5 4 5m1 8h.01"/>
        </svg>
    </span>
    <h2 class="text-lg font-semibold text-gray-900">{{ "No activities yet"|trans }}</h2>
    <p class="mt-2 text-sm text-gray-500">
        {{ "Connect your Garmin account to fetch your activities automatically, or upload .fit, .tcx or .gpx files from your watch or app."|trans }}
    </p>
    <div class="mt-5 flex flex-wrap justify-center gap-3">
        {% if canConnectGarmin() %}
            <a href="{{ relativeUrl(path('admin_garmin')) }}" class="inline-flex items-center rounded-lg px-4 py-2.5 text-sm font-semibold text-white bg-primary hover:brightness-95">
                {{ "Connect Garmin"|trans }}
            </a>
        {% endif %}
        <a href="{{ relativeUrl(path('admin_file_upload')) }}" class="inline-flex items-center rounded-lg px-4 py-2.5 text-sm font-semibold {{ canConnectGarmin() ? 'text-gray-700 border border-gray-300 bg-white hover:bg-gray-50' : 'text-white bg-primary hover:brightness-95' }}">
            {{ "Upload activity files"|trans }}
        </a>
    </div>
</div>
{% endautoescape %}
