{#- On the Today page while Garmin has had nothing new from the watch for a while. Outside the page cache, so it follows the clock. -#}
{%- set syncStatus = garminSyncStatus() -%}
{%- set staleWatch = syncStatus ? describeStaleWatch(syncStatus) : null -%}
{%- if staleWatch -%}
    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status" data-stale-watch-hint>
        {{ staleWatch }}
    </div>
{%- endif -%}
