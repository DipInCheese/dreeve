{# The main navigation on phones. "More" opens the side menu with everything else. #}
{% set onToday = isActiveNavItem({'/': true, '/today': true}) %}
{% set onHealth = isActiveNavItem({'/health': false}) %}
{% set onTraining = isActiveNavItem({'/dashboard': false, '/activities': false, '/monthly-stats': false, '/best-efforts': false, '/heatmap': false, '/gear': false, '/segments': false}) %}
{% set onInsights = isActiveNavItem({'/insights': false}) %}
{% set tabs = [
    {label: 'Today'|trans, href: relativeUrl(path('today')), active: onToday, icon: 'M12 5V3m0 18v-2M7.05 7.05 5.636 5.636m12.728 12.728L16.95 16.95M5 12H3m18 0h-2M7.05 16.95l-1.414 1.414M18.364 5.636 16.95 7.05M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z'},
    {label: 'Health'|trans, href: relativeUrl(path('health_section', {section: 'sleep'})), active: onHealth, icon: 'M12.01 6.001C6.5 1 1 8 5.782 13.001L12.011 20l6.23-7C23 8 17.5 1 12.01 6.002Z'},
    {label: 'Training'|trans, href: relativeUrl(path('dashboard')), active: onTraining, icon: 'M3 12h4l3-8 4 16 3-8h4'},
    {label: 'Insights'|trans, href: relativeUrl(path('insights')), active: onInsights, icon: 'M9 18h6m-5 3h4M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3Z'},
] %}
<nav class="bottom-tab-bar md:hidden" aria-label="{{ "Main"|trans }}" data-bottom-tab-bar>
    {% for tab in tabs %}
        <a href="{{ tab.href }}" {% if tab.active %}aria-current="page"{% endif %}>
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ tab.icon }}"/>
            </svg>
            <span>{{ tab.label }}</span>
        </a>
    {% endfor %}
    <button type="button" class="unstyled" data-drawer-target="drawer-navigation" data-drawer-toggle="drawer-navigation" aria-controls="drawer-navigation"
            {% if not (onToday or onHealth or onTraining or onInsights) %}aria-current="page"{% endif %}>
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linejoin="round" stroke-width="2" d="M5 5h5v5H5V5Zm9 0h5v5h-5V5ZM5 14h5v5H5v-5Zm9 0h5v5h-5v-5Z"/>
        </svg>
        <span>{{ "More"|trans }}</span>
    </button>
</nav>
