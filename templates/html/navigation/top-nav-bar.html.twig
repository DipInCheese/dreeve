<nav class="text-gray-900 bg-white border-b border-gray-200 px-4 py-2.5 fixed left-0 right-0 top-0 z-1100 group">
    <div class="flex flex-wrap justify-between items-center">
        <div class="flex justify-start items-center">
            {% if inAppContext %}
                <button type="button" id="toggle-sidebar-collapsed-state"
                        aria-controls="drawer-navigation"
                        class="p-1.5 mr-1.5 text-gray-600 rounded-md cursor-pointer hidden md:block hover:text-gray-900 hover:bg-gray-100">
                    <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="4" width="18" height="16" rx="2"/>
                        <path d="M9 4v16"/>
                        <path class="origin-center [transform-box:fill-box] transition-transform duration-300 ease-in-out sidebar-collapsed:rotate-180" d="M16 8l-3 4 3 4"/>
                    </svg>
                    <span class="sr-only">{{ "Toggle sidebar"|trans }}</span>
                </button>
                <button data-drawer-target="drawer-navigation" data-drawer-toggle="drawer-navigation"
                        aria-controls="drawer-navigation"
                        class="md:hidden mr-3 inline-flex items-center justify-center text-gray-600 cursor-pointer select-none">
                    <span aria-hidden="true" class="relative block w-3.5 h-5">
                        <span class="absolute inset-x-0 top-1 h-0.5 rounded-full bg-current transition-all duration-300 ease-in-out drawer-open:top-1/2 drawer-open:-translate-y-1/2 drawer-open:rotate-45"></span>
                        <span class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 rounded-full bg-current transition-all duration-300 ease-in-out drawer-open:opacity-0"></span>
                        <span class="absolute inset-x-0 bottom-1 h-0.5 rounded-full bg-current transition-all duration-300 ease-in-out drawer-open:bottom-1/2 drawer-open:translate-y-1/2 drawer-open:-rotate-45"></span>
                    </span>
                    <span class="sr-only">{{ "Toggle sidebar"|trans }}</span>
                </button>
            {% endif %}
            <a href="{{ relativeUrl(path('dashboard')) }}" class="flex items-center justify-between mr-4">
                <img src="{{ relativeUrl('assets/images/logo.svg') }}" class="rounded-full mr-3 h-8" alt="Logo"/>
                <div class="flex gap-x-1 sm:text-lg font-extrabold whitespace-nowrap">
                    <div>{{ appName }}</div>
                    {% if subTitle %}
                        <div class="hidden md:block">|</div>
                        <div class="hidden md:block">{{ subTitle }}</div>
                    {% endif %}
                </div>
            </a>
            {% if importStatus.isPending() %}
            <span id="import-pending-badge"
                  class="ml-2 pill pill--warning px-2.5 text-xs font-semibold"
                  title="{{ "Changes still need to be processed before they appear on the app"|trans({}, 'admin') }}">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-current opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-current"></span>
                </span>
                {{ "Import pending"|trans({}, 'admin') }}
            </span>
            {% endif %}
        </div>
        <div class="flex items-center text-gray-500 lg:order-2 gap-x-2">
            {% if inAppContext %}
                <button id="profileDropdownMenuButton" data-dropdown="profileDropdownMenu" class="cursor-pointer flex rounded-full border" type="button">
                    <span class="sr-only">Open user menu</span>
                    {% if profilePictureUrl %}
                        <img class="size-8 rounded-full bg-white" src="{{ profilePictureUrl }}" alt="Profile Picture">
                    {% else %}
                        <div class="size-8 shrink-0 rounded-full border flex items-center justify-center bg-primary text-white text-xs p-1">
                            {{ athlete.getFirstLetterOfFirstName()|upper }}
                        </div>
                    {% endif %}
                </button>
                <div id="profileDropdownMenu" class="z-10 hidden bg-white border border-gray-200 rounded-lg shadow-lg w-72">
                    <div class="p-2">
                        <div class="flex items-center px-2.5 p-2 space-x-1.5 text-sm bg-gray-50 rounded-sm">
                            {% if profilePictureUrl %}
                                <img class="size-8 rounded-full bg-white" src="{{ profilePictureUrl }}" alt="Profile Picture">
                            {% else %}
                                <div class="size-8 shrink-0 rounded-full border flex items-center justify-center bg-primary text-white text-xs p-1">
                                    {{ athlete.getFirstLetterOfFirstName()|upper }}
                                </div>
                            {% endif %}
                            <div>
                                <div class="font-medium text-gray-900">{{ athlete.getName() }}</div>
                            </div>
                        </div>
                    </div>
                    <ul class="px-2 pb-2 text-sm text-body font-medium" aria-labelledby="profileDropdownMenuButton">
                        {% if isAIIntegrationWithUIEnabled() %}
                            <li>
                                <a href="{{ relativeUrl(path('chat')) }}" data-close-dropdown
                                   class="inline-flex items-center w-full p-2 hover:bg-gray-50 rounded">
                                    <svg class="size-4 me-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17h6l3 3v-3h2V9h-2M4 4h11v8H9l-3 3v-3H4V4Z"/>
                                    </svg>
                                    {{ "Workout assistant"|trans }}
                                </a>
                            </li>
                        {% endif %}
                        <li class="pb-1.5">
                            <a href="{{ relativeUrl(path('badges')) }}" data-close-dropdown
                               class="inline-flex items-center w-full p-2 hover:bg-gray-50 rounded">
                                <svg class="size-4 me-1.5" fill="currentColor" xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 507.9 507.9" xml:space="preserve"><g stroke-width="0"></g><g stroke-linecap="round" stroke-linejoin="round"></g><g><g><g><path d="M465.7,96.55H324.9v-21.6c0-7.8-6.3-14.1-14.1-14.1H197.2c-7.8,0-14.1,6.3-14.1,14.1v21.6H42.3c-23.3,0-42.3,19-42.3,42.3 v265.9c0,23.3,19,42.3,42.3,42.3h423.3c23.3,0,42.3-19,42.3-42.3v-265.9C508,115.55,489,96.55,465.7,96.55z M296.7,89.05v32.1 h-85.4v-32.1H296.7z M465.7,418.85H42.3c-7.8,0-14.1-6.3-14.1-14.1v-265.9c0-7.8,6.3-14.1,14.1-14.1h140.8v10.5 c0,7.8,6.3,14.1,14.1,14.1h113.6c7.8,0,14.1-6.3,14.1-14.1v-10.5h140.7c7.8,0,14.1,6.3,14.1,14.1v265.9h0.1 C479.8,412.55,473.5,418.85,465.7,418.85z"></path></g></g><g><g><path d="M440.6,173.65H254c-7.8,0-14.1,6.3-14.1,14.1s6.3,14.1,14.1,14.1h186.6c7.8,0,14.1-6.3,14.1-14.1 S448.4,173.65,440.6,173.65z"></path></g></g><g><g><path d="M440.6,241.95H254c-7.8,0-14.1,6.3-14.1,14.1s6.3,14.1,14.1,14.1h186.6c7.8,0,14.1-6.3,14.1-14.1 C454.7,248.25,448.4,241.95,440.6,241.95z"></path></g></g><g><g><path d="M440.6,310.35H254c-7.8,0-14.1,6.3-14.1,14.1c0,7.8,6.3,14.1,14.1,14.1h186.6c7.8,0,14.1-6.3,14.1-14.1 S448.4,310.35,440.6,310.35z"></path></g></g><g><g><path d="M180.1,160.45H67.4c-7.8,0-14.1,6.3-14.1,14.1v130.5c0,7.8,6.3,14.1,14.1,14.1h112.7c7.8,0,14.1-6.3,14.1-14.1v-130.5 C194.2,166.85,187.9,160.45,180.1,160.45z M166,290.95H81.6v-102.2H166V290.95z"></path></g></g><g><g><path d="M180.1,354.85H67.4c-7.8,0-14.1,6.3-14.1,14.1c0,7.8,6.3,14.1,14.1,14.1h112.7c7.8,0,14.1-6.3,14.1-14.1 S187.9,354.85,180.1,354.85z"></path></g></g></g></svg>
                                {{ "Badges"|trans }}
                            </a>
                        </li>
                        <li class="border-t border-gray-200 pt-1.5">
                            <label for="darkModeToggle" class="dark-mode-toggle hover:bg-gray-50 rounded p-2 flex cursor-pointer items-center">
                                <div class="inline-flex items-center">
                                    <svg class="size-4 me-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21a9 9 0 0 1-.5-17.986V3c-.354.966-.5 1.911-.5 3a9 9 0 0 0 9 9c.239 0 .254.018.488 0A9.004 9.004 0 0 1 12 21Z"/></svg>
                                    <span class="text-sm font-medium text-heading">{{ "Dark mode"|trans }}</span>
                                </div>
                                <input id="darkModeToggle" type="checkbox" value="" class="peer sr-only" />
                                <div class="ms-auto peer peer-checked:after:border-buffer relative h-5 w-9 rounded-full bg-gray-200 peer-checked:bg-gray-100 peer-focus:outline-none after:absolute after:start-[2px] after:top-[2px] after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full"></div>
                            </label>
                        </li>
                        <li>
                            <form method="post" action="{{ relativeUrl(path('admin_logout')) }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                <button type="submit" class="unstyled inline-flex items-center w-full p-2 hover:bg-gray-50 rounded cursor-pointer">
                                    <svg class="size-4 me-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12H4m12 0-4 4m4-4-4-4m3-4h2a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3h-2"/>
                                    </svg>
                                    {{ "Sign out"|trans({}, 'admin') }}
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>
</nav>