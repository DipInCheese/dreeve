{% autoescape false %}
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <title>{{ "Admin panel"|trans({}, 'admin') }} | {{ appName }}</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width">
        <meta name="theme-color" content="#F26822">
        <meta name="mobile-web-app-title" content="{{ appName }}">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="csrf-token" content="{{ csrf_token('dispatch-command') }}">
        <meta name="dispatch-command-url" content="{{ relativeUrl(path('admin_dispatch_command')) }}">
        <meta name="import-status-url" content="{{ relativeUrl(path('admin_import_status')) }}">
        <meta name="js-dist-url" content="{{ relativeUrl('js/dist/') }}">
        <link rel="icon" type="image/x-icon" href="{{ relativeUrl('assets/images/logo.svg') }}">
        <link href="{{ relativeUrl(asset('css/dist/tailwind.min.css')) }}" rel="stylesheet"/>
        {% block stylesheets %}{% endblock %}
        <script>
            document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'light');
            if (localStorage.getItem('sideNavCollapsed') === 'true') {
                document.documentElement.setAttribute('data-sidebar-collapsed', '');
            }
        </script>
    </head>
    <body class="min-h-screen bg-gray-50 text-gray-900 antialiased admin">
        {% include 'html/admin/component/toast-messages.html.twig' %}
        {% set hideAdminNavigation = hideAdminNavigation ?? false %}
        {% set hasSubNav = isActiveNavItem({'/admin/gear': false}) or isActiveNavItem({'/admin/settings': false}) or isActiveNavItem({'/admin/automation-rules': false}) %}
        <!-- NAVIGATION -->
        {% include 'html/navigation/top-nav-bar.html.twig' with {
            inAppContext: not hideAdminNavigation,
            subTitle: null,
            profilePictureUrl: hideAdminNavigation ? null : appProfilePictureUrl(),
            athlete: hideAdminNavigation ? null : appAthlete(),
        } %}
        <!-- SIDEBAR -->
        {% if not hideAdminNavigation %}
            {# Pages with a sub menu shrink the sidebar to its icons and show the sub menu next to it. #}
            <aside id="drawer-navigation" class="{{ hasSubNav ? 'sidebar--with-contextual-panel' }} -translate-x-full md:translate-x-0 transition-transform" aria-label="Sidenav">
                {{ appSidebar() }}
                {% include 'html/admin/navigation/contextual-panel.html.twig' %}
            </aside>
        {% endif %}
        <main class="p-4 {{ hideAdminNavigation ? '' : (hasSubNav ? 'md:ml-76' : 'md:ml-64 sidebar-collapsed:md:ml-16') }} h-auto min-h-screen pt-20 text-gray-900">
            {% block main %}
            {% endblock main %}
        </main>
        <script src="{{ relativeUrl(asset('js/dist/admin.min.js')) }}" type="module"></script>
    </body>
    </html>
{% endautoescape %}