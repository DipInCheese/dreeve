{% extends "html/admin/page/template.html.twig" %}

{% block main %}
    {% set cron = settings.cron ?? {} %}
    {% set schedules = {
        '0 4 * * *': "Every day at 04:00"|trans({}, 'admin'),
        '0 7 * * *': "Every day at 07:00"|trans({}, 'admin'),
        '0 8 * * *': "Every day at 08:00"|trans({}, 'admin'),
        '0 12 * * *': "Every day at 12:00"|trans({}, 'admin'),
        '0 18 * * *': "Every day at 18:00"|trans({}, 'admin'),
        '0 20 * * *': "Every day at 20:00"|trans({}, 'admin'),
        '0 8 * * 1': "Every Monday at 08:00"|trans({}, 'admin'),
        '0 8 1 * *': "The first day of every month at 08:00"|trans({}, 'admin'),
    } %}
    <div class="flex flex-col gap-4">
        <form data-dispatch-command="{{ dispatchCommand }}" class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <input type="hidden" name="group" value="{{ group.value }}">
            <div class="mb-5">
                <h3 class="text-lg font-semibold">{{ "Reminders"|trans({}, 'admin') }}</h3>
                <p class="description">
                    {{ "Notifications Dreeve sends you on a schedule. They need a notification service, set one up under Notifications & AI."|trans({}, 'admin') }}
                </p>
            </div>
            <div data-form-error class="form-error hidden" role="alert"></div>
            <div class="alert alert--info mb-4" role="alert">
                <span class="sr-only">{{ "Info"|trans({}, 'admin') }}</span>
                <div>
                    {{ "Changes take effect the next time Dreeve restarts."|trans({}, 'admin') }}
                </div>
            </div>
            <div class="flex flex-col gap-3">
                {% for action in enum('App\\Infrastructure\\Daemon\\Cron\\CronActionId').cases() %}
                    {% set actionId = action.value %}
                    {% set stored = cron[actionId] ?? {} %}
                    {% set current = stored.expression ?? action.defaultCronExpression %}
                    <div class="flex flex-col gap-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
                        <label class="flex items-center gap-2 mt-0! font-medium cursor-pointer">
                            <input type="checkbox" name="data[cron][{{ actionId }}][enabled]" value="1"
                                   {{ (stored.enabled ?? false) ? 'checked' : '' }}>
                            <span>{{ action|trans }}</span>
                        </label>
                        <p class="description mt-0!">{{ action|transDescription }}</p>
                        <div>
                            <label for="cron-{{ actionId }}">{{ "When"|trans({}, 'admin') }}</label>
                            <select id="cron-{{ actionId }}" name="data[cron][{{ actionId }}][expression]">
                                {% if current not in schedules|keys %}
                                    <option value="{{ current }}" selected>{{ "Custom schedule ({expression})"|trans({'{expression}': current}, 'admin') }}</option>
                                {% endif %}
                                {% for expression, label in schedules %}
                                    <option value="{{ expression }}" {{ expression == current ? 'selected' : '' }}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="flex justify-end gap-2 border-t border-gray-200 pt-4 mt-6">
                <button type="submit" data-has-loading-state class="group btn--primary">
                    <span class="label">{{ "Save settings"|trans({}, 'admin') }}</span>
                    <span class="label--loading">{{ "Saving..."|trans({}, 'admin') }}</span>
                </button>
            </div>
        </form>
    </div>
{% endblock main %}
