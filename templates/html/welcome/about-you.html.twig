{% extends "html/admin/page/template.html.twig" %}
{% set hideAdminNavigation = true %}
{% block main %}
    <div class="modal-like-form">
        <div class="w-full max-w-2xl overflow-y-auto p-6 bg-white border border-gray-200 rounded-lg shadow-xl" data-welcome-step="about-you">
            {% include 'html/welcome/steps.html.twig' with {step: step} only %}
            <div class="mb-4">
                <h1 class="text-xl font-bold">{{ "Welcome to Dreeve"|trans }}</h1>
                <p class="mt-1 text-sm text-gray-500">
                    {{ "First a few things about you. Your heart rate zones and training load are calculated from them. Everything else you can change later in Settings."|trans }}
                </p>
            </div>
            <form data-dispatch-command="{{ dispatchCommand }}" data-redirect="{{ relativeUrl(path('welcome_connect')) }}" class="flex flex-col gap-4">
                <div data-form-error class="form-error hidden" role="alert"></div>
                {% include 'html/admin/page/settings/athlete-fields.html.twig' with {
                    fieldPrefix: 'athlete',
                    athlete: settings,
                } only %}
                <div class="flex justify-end gap-2 border-t border-gray-200 pt-4">
                    <button type="submit" data-has-loading-state class="group btn--primary">
                        <span class="label">{{ "Next"|trans }}</span>
                        <span class="label--loading">{{ "Saving..."|trans({}, 'admin') }}</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock main %}
