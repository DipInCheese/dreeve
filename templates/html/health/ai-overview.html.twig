{# The latest AI overview, on top of Today. Expects: overview (Overview), today. Everything is escaped text. #}
{% set writtenToday = overview.writtenOn|date('Y-m-d') == today|date('Y-m-d') %}
<section class="mb-4 p-4 bg-white border border-gray-200 rounded-lg shadow-xs" data-ai-overview="{{ overview.slot.value }}">
    <div class="flex flex-wrap items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-primary-dark">
            <svg class="size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 18h6m-5 3h4M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3Z"/>
            </svg>
            {{ "AI overview"|trans }}
        </span>
        <span class="text-xs text-gray-500">
            {% if writtenToday %}
                {{ "Written at {time}"|trans({'{time}': overview.writtenOn|date('H:i')}) }}
            {% else %}
                {{ "Written yesterday at {time}"|trans({'{time}': overview.writtenOn|date('H:i')}) }}
            {% endif %}
        </span>
    </div>
    <h2 class="mt-2 text-lg font-semibold text-gray-900">{{ overview.headline }}</h2>
    <p class="mt-1 text-sm leading-relaxed text-gray-700">{{ overview.summary }}</p>
    {% if overview.tips is not empty %}
        <ul class="mt-3 space-y-1.5 text-sm text-gray-700">
            {% for tip in overview.tips %}
                <li class="flex gap-2"><span aria-hidden="true" class="text-primary">•</span><span>{{ tip }}</span></li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
