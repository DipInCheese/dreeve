{% set toneClasses = {
    'good': 'bg-green-50 text-green-700',
    'bad': 'bg-amber-50 text-amber-800',
    'neutral': 'bg-gray-100 text-gray-600',
} %}
<div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
    <h1 class="text-xl font-extrabold text-gray-900">{{ "Insights"|trans }}</h1>
    <span class="text-sm text-gray-500">{{ snapshot.from|date('d-m-Y') }} – {{ snapshot.till|date('d-m-Y') }}</span>
</div>

{% if snapshot.hasData() %}
    <section class="mb-4 p-4 bg-white border border-gray-200 rounded-lg shadow-xs" data-weekly-summary>
        <h2 class="text-lg font-semibold text-gray-900">{{ "Your last 7 days"|trans }}</h2>
        <p class="mt-1 text-sm text-gray-600">{{ "Each number is your average for the week, next to your normal from before it and the week before."|trans }}</p>
        <ul class="mt-4 divide-y divide-gray-100">
            {% for metric in snapshot.metrics|filter(metric => metric.daysMeasured > 0) %}
                {% set change = metric.change() %}
                {% set formattedChange = change is null ? null : metric.metric.format(change|abs) %}
                <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3" data-week-metric="{{ metric.metric.value }}">
                    <span class="text-sm font-medium text-gray-900">{{ metric.metric|trans }}</span>
                    <span class="flex flex-wrap items-center gap-2 text-sm">
                        <span class="font-semibold text-gray-900" data-count-up>{{ metric.metric.format(metric.average) }}{% if metric.metric.displayUnit() %} {{ metric.metric.displayUnit() }}{% endif %}</span>
                        <span class="rounded-full px-2 py-0.5 text-xs font-medium {{ toneClasses[metric.tone()] }}">{{ metric.comparison()|trans }}</span>
                        {# A change that rounds to nothing is no change. #}
                        {% if formattedChange is not null and formattedChange matches '/[1-9]/' %}
                            <span class="text-xs text-gray-500">
                                {{ (change > 0 ? "{value} more than the week before" : "{value} less than the week before")|trans({'{value}': formattedChange}) }}
                            </span>
                        {% endif %}
                    </span>
                </li>
            {% endfor %}
        </ul>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
        <section class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs" data-sleep-rhythm>
            <h2 class="text-lg font-semibold text-gray-900">{{ "Sleep rhythm"|trans }}</h2>
            {% set rhythm = snapshot.sleepRhythm %}
            {% if rhythm.averageBedtimeInMinutes is not null %}
                <p class="mt-2 text-sm text-gray-700">
                    {{ "Bedtime around {bedtime}, up around {wakeTime}."|trans({'{bedtime}': rhythm.formatTime(rhythm.averageBedtimeInMinutes), '{wakeTime}': rhythm.formatTime(rhythm.averageWakeTimeInMinutes)}) }}
                </p>
                <p class="mt-1 text-sm text-gray-600">
                    {{ "Your bedtime moved by about {minutes} minutes from night to night."|trans({'{minutes}': rhythm.bedtimeSpreadInMinutes}) }}
                </p>
            {% elseif rhythm.nights > 0 %}
                <p class="mt-2 text-sm text-gray-500">{{ "Your watch recorded sleep, but not when you went to bed and got up."|trans }}</p>
            {% else %}
                <p class="mt-2 text-sm text-gray-500">{{ "No sleep recorded this week."|trans }}</p>
            {% endif %}
        </section>

        <section class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs" data-week-training>
            <h2 class="text-lg font-semibold text-gray-900">{{ "Training"|trans }}</h2>
            {% set training = snapshot.training %}
            {% if training.activities > 0 %}
                <p class="mt-2 text-sm text-gray-700">
                    {{ "{count} activities, {hours} hours, {distance} km."|trans({'{count}': training.activities, '{hours}': (training.movingTimeInSeconds / 3600)|number_format(1), '{distance}': training.distanceInKm|number_format(1)}) }}
                </p>
                <ul class="mt-2 space-y-1 text-sm text-gray-600">
                    {% for activity in training.longestActivities %}
                        <li>{{ activity.day|date('d-m') }} · {{ activity.name }} · {{ activity.minutes }} min</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="mt-2 text-sm text-gray-500">{{ "No activities this week."|trans }}</p>
            {% endif %}
        </section>
    </div>
{% else %}
    <div class="mb-4 p-6 bg-white border border-gray-200 rounded-lg shadow-xs" data-insights-empty>
        <h2 class="text-lg font-semibold text-gray-900">{{ "Nothing to summarise yet"|trans }}</h2>
        <p class="mt-2 text-sm text-gray-600">{{ "Once your watch data comes in, this page sums up your week."|trans }}</p>
        <a href="{{ relativeUrl(path('admin_garmin')) }}" class="mt-3 inline-block text-sm font-medium text-primary-dark hover:underline">{{ "Connect Garmin"|trans }}</a>
    </div>
{% endif %}

<div class="max-w-2xl p-6 bg-white border border-gray-200 rounded-lg shadow-xs" data-insights-coming>
    <h2 class="text-lg font-semibold text-gray-900">{{ "AI analysis: coming soon"|trans }}</h2>
    <p class="mt-2 text-sm text-gray-600">
        {{ "Later, Dreeve can use the summary above to explain how your week went and what to adjust."|trans }}
    </p>
    <p class="mt-3 text-sm text-gray-600">
        {{ "It will use AI only if you switch it on. Your health data would then go to the AI provider you choose; with a local model it never leaves your server."|trans }}
    </p>
</div>
