# ---------------------------------------------------------------------------
# Dreeve, multi-user edition. Copy this file to ".env" and fill it in.
# Keep it private: "chmod 600 .env" on Linux.
# ---------------------------------------------------------------------------

# The Dreeve image to run, published by the fork you use.
DREEVE_IMAGE=ghcr.io/<github-user>/dreeve:multi-user

# Your timezone: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=Europe/Brussels

# Cloudflare Tunnel token: Zero Trust > Networks > Tunnels > your tunnel.
TUNNEL_TOKEN=

# The address of every user, {user} is replaced by the user's name.
# Point the wildcard hostname (*.example.com) of your Cloudflare Tunnel at http://app:8080.
DREEVE_USER_URL=https://{user}.example.com

# Your own user name. On the first start you become the owner: you can add and invite
# other users from the "Users" page in your admin panel. Your setup link is printed in
# the logs: docker compose logs app
DREEVE_OWNER=alice

# ---------------------------------------------------------------------------
# Optional. Settings here apply to every user. A single user's settings go in
# data/<name>/.env, e.g. their Strava API keys.
# See https://docs.dreeve.app/getting-started/installation/#env for all settings.
# ---------------------------------------------------------------------------

# AI workout assistant for everyone.
# AI_API_KEY=

# Run the containers as a non-root user.
# PUID=1000
# PGID=1000
