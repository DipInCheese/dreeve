# ---------------------------------------------------------------------------
# Dreeve, multi-user edition. Copy this file to ".env" and fill it in.
# Keep it private: it holds the passwords. "chmod 600 .env" on Linux.
# Wrap values containing $ or # in single quotes, e.g. 'my$password#1'.
# ---------------------------------------------------------------------------

# Your timezone: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=Europe/Brussels

# Cloudflare Tunnel token: Zero Trust > Networks > Tunnels > your tunnel.
TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Users: a comma-separated list of names (lowercase letters, digits and dashes).
# Every user's settings start with the user's name in capitals, e.g. ALICE_...
# ---------------------------------------------------------------------------
DREEVE_USERS=alice,bob

# The address the user opens Dreeve on. Add this hostname to your Cloudflare Tunnel.
ALICE_URL=https://alice.example.com
# Admin login: username "alice" (change with ALICE_USERNAME), at least 12 characters.
ALICE_PASSWORD=

BOB_URL=https://bob.example.com
BOB_PASSWORD=

# ---------------------------------------------------------------------------
# Optional. Every Dreeve setting can be set per user by adding the user's prefix.
# See https://docs.dreeve.app/getting-started/installation/#env for all settings.
# ---------------------------------------------------------------------------

# Import from Strava instead of activity files (each user needs their own Strava API app).
# ALICE_IMPORT_MODE=stravaApi
# ALICE_STRAVA_CLIENT_ID=
# ALICE_STRAVA_CLIENT_SECRET=
# ALICE_STRAVA_REFRESH_TOKEN=

# AI workout assistant. Without a prefix, a setting applies to every user.
# AI_API_KEY=

# Run the containers as a non-root user.
# PUID=1000
# PGID=1000
